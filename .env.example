# Copy to .env and adjust
ENVIRONMENT=development
DEBUG=1
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=fego84
POSTGRES_USER=fego84
POSTGRES_PASSWORD=fego84
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Optional: set to 1 to force HTTPS behind proxy
SECURE_PROXY_SSL_HEADER=0

# If you host behind a custom domain and need CSRF protection:
# CSRF_TRUSTED_ORIGINS=https://yourdomain.example
CSRF_TRUSTED_ORIGINS=

# Only used in production compose (nginx) - where collectstatic writes
STATIC_ROOT=
