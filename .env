ENVIRONMENT=production
DEBUG=0

# Generate a strong secret
SECRET_KEY=django-insecure-REPLACE-WITH-LONG-RANDOM-STRING

# Hosts
ALLOWED_HOSTS=fego84election.com,www.fego84election.com

# --- Security / proxy settings ---
SECURE_PROXY_SSL_HEADER=1
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=1
SECURE_HSTS_PRELOAD=1
SECURE_REFERRER_POLICY=same-origin

# CSRF protection (no wildcards allowed)
CSRF_TRUSTED_ORIGINS=https://fego84election.com,https://www.fego84election.com


# Static files
STATIC_ROOT=/app/staticfiles

# --- Database (Railway Postgres service) ---
# Copy these from your Railway Postgres service
DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_PRIVATE_URL=${{Postgres.DATABASE_PRIVATE_URL}}

# --- Optional: set this to 1 if using SSL in production ---
# SSL is required for Railway managed Postgres