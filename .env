ENVIRONMENT=production
DEBUG=0

# Generate a strong secret
SECRET_KEY=django-insecure-REPLACE-WITH-LONG-RANDOM-STRING

# Hosts
ALLOWED_HOSTS=fego84election.com,www.fego84election.com

# Behind Railway proxy
SECURE_PROXY_SSL_HEADER=1

# CSRF protection (no wildcards allowed)
CSRF_TRUSTED_ORIGINS=https://fego84election.com,https://www.fego84election.com


# --- Database ---
# Railway automatically provides these environment variables for Postgres
# DATABASE_URL (public endpoint) and DATABASE_PRIVATE_URL (internal)
# Use DATABASE_PRIVATE_URL when available to avoid egress fees

# Optional: fallback to DATABASE_URL if DATABASE_PRIVATE_URL is empty
DATABASE_PRIVATE_URL=<leave blank; Railway auto-provides>
DATABASE_URL=<leave blank; Railway auto-provides>

# --- Security / HSTS ---
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=1
SECURE_HSTS_PRELOAD=1
SECURE_REFERRER_POLICY=same-origin