ENVIRONMENT=production
DEBUG=0

# Generate a strong secret
SECRET_KEY=django-insecure-REPLACE-WITH-LONG-RANDOM-STRING

# Hosts
ALLOWED_HOSTS=.railway.app,fego84election.com,www.fego84election.com

# Behind Railway proxy
SECURE_PROXY_SSL_HEADER=1

# CSRF protection (no wildcards allowed)
CSRF_TRUSTED_ORIGINS=https://your-app-name.up.railway.app,https://fego84election.com,https://www.fego84election.com

# Static files
STATIC_ROOT=/app/staticfiles