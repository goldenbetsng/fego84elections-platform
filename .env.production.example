# Copy to .env for production deployment
ENVIRONMENT=production
DEBUG=0

# MUST be a strong random string
SECRET_KEY=replace-with-strong-random

# Set to your domain(s)
ALLOWED_HOSTS=yourdomain.example

# If behind a reverse proxy / TLS termination, set this to 1
SECURE_PROXY_SSL_HEADER=1

# Required for Django CSRF if you access admin on a custom domain
CSRF_TRUSTED_ORIGINS=https://yourdomain.example

# Postgres
POSTGRES_DB=fego84
POSTGRES_USER=fego84
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Static collection path for nginx container
STATIC_ROOT=/static

# Security toggles
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=1
SECURE_HSTS_PRELOAD=1

# Gunicorn tuning
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60